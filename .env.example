# ==============================================================================
# CityRock POS Frontend — Environment Variables Template
# ==============================================================================
# For Local Development: Copy this file to .env.local in the frontend/ folder
# NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# For Production (Vercel):
# Set these variables in Vercel Project Settings -> Environment Variables:
# (Replace with your actual deployed backend URL)
NEXT_PUBLIC_API_URL=https://cityrock-pos-backend.vercel.app/api/v1
NEXT_PUBLIC_BACKEND_URL=https://cityrock-pos-backend.vercel.app
